Art     = int(input('Arts               :'))
English = int(input('English            :'))
History = int(input('History            :'))
PE      = int(input('Physical Education :'))
Math    = int(input('Mathematics        :'))
Science = int(input('Science            :'))
Writing = int(input('Writing            :'))

#Passing
print("--------------------------------------------------")
def check(subject, grade):
    if grade >= 75:
        print(f"{subject}: Passed")
        if grade >= 90:
            print(f"GPA {subject}: 4.0 \n")
        elif grade >= 85:
            print(f"GPA {subject}: 3.5 \n")
        elif grade >= 80:
            print(f"GPA {subject}: 3.0 \n")
        elif grade >= 75:
            print(f"GPA {subject}: 2.0 \n")
        else:
            print(f"GPA {subject}: 1.0 \n")
    elif grade < 75:
        print(f"{subject}: Failed")
        print(f"GPA {subject}: 1.0 \n")
    else:
        print("Error")

check("Arts", Art)
check("English", English)
check("History", History)
check("Physical Education", PE)
check("Mathematics", Math)
check("Science", Science)
check("Writing", Writing)



#Computation
Sum = (Art + English + History + PE + Math + Science + Writing) / 7

#Output
print("--------------------------------------------------")
print(f"Name: {SName}")
print(f"Course: {CName}")
print(f"Average: {Sum:.2f}")

